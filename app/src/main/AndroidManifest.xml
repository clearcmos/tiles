<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Granted once over adb, which is possible because the platform declares this
      permission with the "development" protection flag:
        adb shell pm grant com.clearcmos.tiles android.permission.WRITE_SECURE_SETTINGS
      Without it every write to adb_wifi_enabled throws SecurityException and the app
      falls back to opening the Wireless debugging settings page.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- The Calls tile asks the workstation over SSH. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tiles">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Long-pressing the Quick Settings tile lands here instead of on nothing. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          The home-screen surface. Launcher shortcuts targeting this can be dragged onto
          a home screen, which gives a one-tap icon without an AppWidgetProvider.
        -->
        <activity
            android:name=".wirelessdebug.ToggleActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/toggle_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tiles.Invisible" />

        <service
            android:name=".wirelessdebug.WirelessDebuggingTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Tells the shade this is a toggle, so a tap flips it rather than opening a detail view. -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <!-- Android 16 groups the tile editor by category. -->
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_CONNECTIVITY" />
        </service>

        <service
            android:name=".calls.CallsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_calls"
            android:label="@string/calls_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_CONNECTIVITY" />
        </service>
    </application>
</manifest>
